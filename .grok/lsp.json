{
  "rust-analyzer": {
    "command": "rust-analyzer",
    "extensionToLanguage": {
      ".rs": "rust"
    },
    "initializationOptions": {
      "cargo": {
        "target": "thumbv7em-none-eabihf",
        "allTargets": false
      },
      "cfg": {
        "setTest": false
      },
      "check": {
        "allTargets": false,
        "extraArgs": ["--bins"],
        "workspace": false
      }
    },
    "settings": {
      "cargo": {
        "target": "thumbv7em-none-eabihf",
        "allTargets": false
      },
      "cfg": {
        "setTest": false
      },
      "check": {
        "allTargets": false,
        "extraArgs": ["--bins"],
        "workspace": false
      }
    }
  }
}
